# Copy to apps/mobile/.env and restart Expo (`npx expo start -c` clears cache).
#
# Local API on iOS Simulator (default — leave unset or use localhost):
# EXPO_PUBLIC_API_URL=http://localhost:3000
#
# Local API on a physical phone (same Wi‑Fi as your Mac; find IP in System Settings → Network):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
#
# Deployed API (required for Google sign-in — redirect URI uses this host):
EXPO_PUBLIC_API_URL=https://sosync-api.onrender.com

# Google OAuth Web client ID (same value as GOOGLE_CLIENT_ID on the API / Render)
# Google Cloud → Credentials → OAuth 2.0 Client ID → Web application
EXPO_PUBLIC_GOOGLE_CLIENT_ID=848622985243-i7jt26kbhc5anshkvlh4iql3uoh83uov.apps.googleusercontent.com.apps.googleusercontent.com

# Google Console → Authorized redirect URIs (must match EXPO_PUBLIC_API_URL host):
#   https://sosync-api.onrender.com/auth/google/callback
# Google Console → Authorized JavaScript origins:
#   https://sosync-api.onrender.com
