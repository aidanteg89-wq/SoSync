# --- Database ---
# For Supabase, use the SESSION POOLER URL (IPv4-compatible) from
# Project Settings → Database → Connection string → "Session pooler".
# URL-encode any special characters in the password (@ → %40, # → %23, etc).
# Format: postgresql://postgres.<ref>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.your-ref:your-password@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Use a long random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET="your-jwt-secret-here"

# --- Google OAuth (required for Google sign-in + Calendar sync) ---
# Create an OAuth 2.0 Client ID of type "Web application" in
# Google Cloud Console → APIs & Services → Credentials.
# Mobile client sends authorization codes; the API exchanges them here.
#
# Authorized redirect URIs (Google requires https:// on a public domain):
#   https://YOUR-SERVICE.onrender.com/auth/google/callback
#
# Authorized JavaScript origins (same host, no path):
#   https://YOUR-SERVICE.onrender.com
#
# The same client ID must also be set in apps/mobile/app.json under
# expo.extra.googleClientId. EXPO_PUBLIC_API_URL must match the same host.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Server ---
# Port to listen on. Defaults to 3000 if not set.
PORT=3000
# Bind address (0.0.0.0 allows phones on your LAN to reach the API).
HOST=0.0.0.0

# Comma-separated origins for Expo web (optional). Native apps ignore CORS.
# ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
